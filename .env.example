# AI Safety SIEM Gateway — Environment Configuration Template
# Copy this file to .env and fill in your values.
# All defaults shown below are for local development.

# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ASSISTANT_MODEL=llama3.1
OLLAMA_GUARD_MODEL=llama-guard3
OLLAMA_TIMEOUT_SECONDS=120.0

# Data store paths (relative to working directory)
SQLITE_DB_PATH=./data/gateway.db
JSONL_AUDIT_PATH=./data/audit.jsonl

# Gateway binding (local-only by default — do NOT change to 0.0.0.0 for production)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# Simple local authentication (separates admin actions from chat).
# Set GATEWAY_AUTH_ENABLED=false to disable entirely for a frictionless local demo.
GATEWAY_AUTH_ENABLED=true
GATEWAY_ADMIN_TOKEN=admin-local-dev-token
GATEWAY_USER_TOKEN=user-local-dev-token
